{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "profile",
  "main": "worker.js",
  "compatibility_date": "2025-09-27",
  // Runs before every `wrangler deploy` and `wrangler dev`, so the build
  // version is stamped even when the npm lifecycle is bypassed.
  "build": {
    "command": "bash scripts/stamp-version.sh"
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // By default, requests matching a static asset never reach the Worker,
    // which would let blocked countries/bots bypass the traffic-quality gate
    // in worker.js for every static page. Running the Worker first puts the
    // gate in front of ALL paths; unmatched requests fall through to
    // env.ASSETS.fetch() as before.
    "run_worker_first": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    { "pattern": "guillermosalas.dev", "custom_domain": true },
    { "pattern": "www.guillermosalas.dev", "custom_domain": true },
    // removed net route
    // removed www net route
  ],
  "send_email": [
    {
      "name": "SEND_EMAIL"
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "portfolio"
    }
  ]
}
